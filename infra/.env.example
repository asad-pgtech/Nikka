# Copy to infra/.env and fill in. NEVER commit infra/.env.

# ---- Hostname & TLS --------------------------------------------------------------------------------
# Your free DuckDNS subdomain (without .duckdns.org). Its A record must point to this host's PRIVATE
# LAN IP (e.g. 192.168.1.50). WARNING: never change it after people install the app — browser storage
# (keys + chat history) is bound to the hostname.
DUCKDNS_SUBDOMAIN=mytasks
DUCKDNS_TOKEN=00000000-0000-0000-0000-000000000000
# Optional, space-separated full hostnames also served (same DuckDNS account), e.g. the previous name
# during a rename so people can still open the old app and export a backup. Remove when done.
EXTRA_HOSTNAMES=

# ---- MongoDB ---------------------------------------------------------------------------------------
# Use letters and digits only (the password is embedded in a connection URL).
MONGO_ROOT_USER=tasks
MONGO_ROOT_PASSWORD=change-me-to-a-long-random-string
MONGO_DB=lanchat

# ---- API -------------------------------------------------------------------------------------------
# Signs short-lived session tokens. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Web Push (VAPID). Generate with:  make vapid
#   (= docker compose -f infra/docker-compose.yml run --rm --no-deps api python -m app.scripts.gen_vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services (mailto: or https: URL). Not shown to users.
VAPID_SUBJECT=mailto:admin@localhost

# ---- Limits ----------------------------------------------------------------------------------------
MAX_FILE_MB=100
CHUNK_KB=512
MAX_PAYLOAD_KB=64
MEDIA_TTL_DAYS=30
QUEUE_TTL_DAYS=30
REQUEST_COOLDOWN_HOURS=24
REQUEST_DAILY_CAP=20
LOOKUP_PER_MINUTE=30
AUTOLOCK_DEFAULT_SECONDS=120
SESSION_TTL_MINUTES=60
JOB_INTERVAL_SECONDS=300
LOG_LEVEL=INFO
